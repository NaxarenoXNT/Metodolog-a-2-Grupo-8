# Variables de docker-compose.yml. Copiar a .env (no se sube al repo).
# Elegí una contraseña y usala también en DATABASE_URL de backend/.env.
# Solo se aplica al crear el volumen; para cambiarla después hay que recrearlo.
POSTGRES_PASSWORD=

# Puerto del host para PostgreSQL (opcional, por defecto 5432).
# POSTGRES_PORT=5432
