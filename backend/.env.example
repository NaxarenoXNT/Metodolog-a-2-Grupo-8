# Puerto del servidor Express
PORT=3000

# Base de datos PostgreSQL (contenedor local del grupo, ver docker-compose.yml).
# Reemplazá <POSTGRES_PASSWORD> por la contraseña del .env de la raíz.
# Sin esta variable, el backend usa repositorios en memoria.
DATABASE_URL=postgresql://grupo8:<POSTGRES_PASSWORD>@localhost:5432/viajes

# API Key de Mapbox para calcular la distancia de los viajes.
# Sin esta variable, en desarrollo se usa ProveedorRutasFalso (690 km fijos).
MAPBOX_API_KEY=

# Secreto obligatorio para firmar tokens JWT. Cambiarlo en cada ambiente.
JWT_SECRET=tu_secreto_aqui
