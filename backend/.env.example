# Puerto del servidor Express
PORT=3000

# Base de datos PostgreSQL (contenedor local del grupo).
# Sin esta variable, el backend usa repositorios en memoria.
DATABASE_URL=postgresql://grupo8:grupo8@localhost:5432/viajes

# API Key de Mapbox para calcular la distancia de los viajes.
# Sin esta variable, en desarrollo se usa ProveedorRutasFalso (690 km fijos).
MAPBOX_API_KEY=

# --- Variables futuras (aún no usadas por el código) ---
# Secreto para firmar tokens JWT (se integrará con autenticación)
# JWT_SECRET=tu_secreto_aqui
